      "parameters": {
        "jsCode": "// 1. Obtenemos la info del Google Sheet (nodo anterior)\nconst servicio = items[0].json; \n\n// Asegúrate que 'Categoria' coincida con el nombre de tu columna en el Excel\nconst categoriaInput = servicio.Categoria || \"General\"; \n\n// 2. TU MAPA DE CALENDARIOS\nconst CALENDARIOS = {\n    \"Manos\": \"75b7e91dba23da912a71a0ffa06cab3cd5afa80cfa7233980242c896cebb5560@group.calendar.google.com\",\n    \"Pies\": \"4838d7250fd5b35a3f8356f9725c7a1fd25a5a9d9abf9d9a8881c063b112b9e3@group.calendar.google.com\",\n    \"Rostro\": \"9ccfcd29530dad189b3a88b32a7f34ea7559624755355fce9aa36507b8ca3734@group.calendar.google.com\",\n    \"Cabello\": \"d0a7dd190e9df87d83b8bfb91724da6d6c0ef367189a2ce49a48fb4c1aa5b474@group.calendar.google.com\",\n    \"General\": \"martinenrique.pe@gmail.com\" \n};\n\n// Buscamos la categoría ignorando mayúsculas/minúsculas\nconst catKey = Object.keys(CALENDARIOS).find(key => key.toLowerCase() === String(categoriaInput).toLowerCase());\nconst calendarioFinal = CALENDARIOS[catKey] || CALENDARIOS.General;\n\n// 3. CÁLCULO DE FECHAS (VERSIÓN JAVASCRIPT NATIVO - SIN LUXON)\n// Obtenemos inicio del webhook\nconst inicioStr = $('Webhook').first().json.body.start_time;\nconst duracionMin = parseInt(servicio.Duracion || 60);\n\n// Creamos objetos Fecha\nconst fechaInicio = new Date(inicioStr);\n// Sumamos minutos: (minutos * 60 segundos * 1000 milisegundos)\nconst fechaFin = new Date(fechaInicio.getTime() + (duracionMin * 60000));\n\nreturn [{\n    json: {\n        calendar_id_destino: calendarioFinal,\n        duracion_minutos: duracionMin,\n        nombre_servicio: servicio.Servicio, // Ajusta si tu columna es diferente\n        categoria_detectada: categoriaInput,\n        // Convertimos a ISO String para que Google Calendar lo entienda\n        check_time_min: fechaInicio.toISOString(),\n        check_time_max: fechaFin.toISOString()\n    }\n}];"
      },
