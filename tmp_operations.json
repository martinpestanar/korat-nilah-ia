  },
  {
    "type": "updateNode",
    "nodeName": "Encender Bot",
    "updates": {
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "operation": "update",
        "tableId": "Clientes",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "telefono",
              "condition": "eq",
              "keyValue": "={{ $('Resolver Tenant').first().json.sender_phone }}"
            },
            {
              "keyName": "business_id",
              "condition": "eq",
              "keyValue": "={{ $('Resolver Tenant').first().json.business_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "bot_pausado",
              "fieldValue": "false"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "YlSUI38ukE7hX1FQ",
          "name": "Supabase account"
        }
      }
    }
  }
]